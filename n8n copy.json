    {
      "parameters": {
        "jsCode": "const body = $('Update Streak Webhook').first().json.body || {};\nconst chatId = String(body.chat_id || \"123456\");\nconst allRows = $input.all();\n\nlet userRow = allRows.find(r => String(r.json.chat_id || \"\").trim() === chatId);\nlet currentStreak = userRow ? parseInt(userRow.json.streak || \"5\", 10) : 5;\nlet lastDate = userRow ? String(userRow.json.last_streak_date || \"\") : \"\";\n\nconst todayStr = new Date().toISOString().split('T')[0];\n\nif (lastDate !== todayStr) {\n  currentStreak += 1;\n  lastDate = todayStr;\n}\n\nreturn [{\n  json: {\n    row_id: chatId,\n    chat_id: chatId,\n    streak: String(currentStreak),\n    last_streak_date: lastDate,\n    updated_streak: currentStreak\n  }\n}];"
      },
