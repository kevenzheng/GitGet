    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst chatId = body.chat_id;\nconst moduleCode = body.module;\nconst semester = body.semester || \"Sem 1\";\nconst freq = body.freq || \"3\";\nconst assessments = body.assessments || [];\n\nlet sheetRows = [];\nlet assessmentText = \"\";\n\nassessments.forEach(a => {\n  sheetRows.push({\n    json: {\n      row_id: `${chatId}_${moduleCode}_${a.name}`,\n      chat_id: String(chatId),\n      \"Module Code\": String(moduleCode),\n      \"Semester\": String(semester),\n      \"Type\": String(a.name),\n      \"Week\": String(a.date),\n      \"Freq (days)\": String(freq),\n      \"Status\": \"pending\"\n    }\n  });\n  assessmentText += `- <b>${a.name}</b> (${a.date}) [Next reminder in ${freq} days]\\n`;\n});\n\nconst formattedText = `📅 <b>Schedule Saved for ${moduleCode}</b>!\\n\\nSaved items:\\n${assessmentText}\\nStatus set to <b>pending</b>.`;\n\nreturn sheetRows.map((r, idx) => ({\n  json: {\n    ...r.json,\n    message_text: idx === 0 ? formattedText : \"\"\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        28544,
        14256
